{
  "name": "@cosmo-merge/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --external:thorvg-canvas --external:@kmamal/sdl --outfile=dist/main.js",
    "start": "yarn build && node dist/main.js",
    "icons": "esbuild src/icons.ts --bundle --platform=node --format=esm --target=node20 --external:thorvg-canvas --external:@kmamal/sdl --outfile=dist/icons.js && node dist/icons.js"
  },
  "dependencies": {
    "@cosmo-merge/engine": "workspace:*",
    "@cosmo-merge/game": "workspace:*",
    "@kmamal/sdl": "^0.11.13",
    "thorvg-canvas": "~0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
